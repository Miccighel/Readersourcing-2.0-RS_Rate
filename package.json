{
  "name": "RS_Rate",
  "version": "2.0.0",
  "description": "Browser extension for the Readersourcing 2.0 ecosystem",
  "repository": "https://github.com/Miccighel/Readersourcing-2.0-RS_Rate",
  "author": "Michael Soprano",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "package:firefox": "yarn build && web-ext build --source-dir dist/firefox --artifacts-dir artifacts --overwrite-dest",
    "test": "node --test",
    "verify": "yarn build && yarn check && yarn lint:firefox && yarn test"
  },
  "resolutions": {
    "jquery": "3.7.1"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bootstrap": "^4.6.2",
    "bootstrap-select": "^1.13.18",
    "bootstrap-slider": "^11.0.2",
    "dropzone": "^5.9.3",
    "jquery": "^3.7.1",
    "jquery-parallax.js": "^1.5.0",
    "jquery.cookie": "^1.4.1",
    "jquery.counterup": "^2.1.0",
    "jquery.scrollto": "^2.1.3",
    "js-cookie": "^3.0.8",
    "load-awesome": "^1.1.0",
    "owl.carousel": "^2.3.4",
    "owl.carousel2.thumbs": "^0.1.8",
    "parsleyjs": "^2.9.2",
    "waypoints": "^4.0.1"
  },
  "devDependencies": {
    "web-ext": "^10.5.0"
  },
  "packageManager": "yarn@4.17.1"
}
