{
  "manifest_version": 3,
  "name": "Readersourcing 2.0: RS_Rate",
  "short_name": "RS_Rate",
  "version": "2.0.0",
  "version_name": "2.0.0",
  "description": "Allows to rate scientific publications within the Readersourcing 2.0 ecosystem.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "src/js/service_worker.js"
    ],
    "type": "module"
  },
  "default_locale": "en",
  "action": {
    "default_popup": "src/views/home.html",
    "default_icon": {
      "16": "src/img/icon16.png",
      "32": "src/img/icon32.png",
      "48": "src/img/icon48.png",
      "128": "src/img/icon128.png"
    }
  },
  "icons": {
    "16": "src/img/icon16.png",
    "32": "src/img/icon32.png",
    "48": "src/img/icon48.png",
    "128": "src/img/icon128.png"
  },
  "options_ui": {
    "page": "src/views/options.html",
    "open_in_tab": false
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rs-rate@readersourcing.org",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "personallyIdentifyingInfo",
          "browsingActivity",
          "websiteActivity",
          "websiteContent"
        ]
      }
    }
  }
}
